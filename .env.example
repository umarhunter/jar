# OpenAI API Key (required)
OPENAI_API_KEY=your-openai-api-key-here

# Flask Secret Key (optional, will use default if not set)
SECRET_KEY=your-secret-key-here

# Database path (optional)
# For Docker: use /app/data/oracle_pilot.db (handled automatically)
# For local: use oracle_pilot.db or custom path
DATABASE_PATH=oracle_pilot.db
